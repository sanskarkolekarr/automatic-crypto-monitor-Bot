# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Owner (you) - numeric Telegram user ID
OWNER_TELEGRAM_ID=

# Extra users allowed to use the bot (comma separated numeric IDs)
# You can also grant access in-chat with /grant (owner, reply to a user's message)
ALLOWED_USER_IDS=

# How many minutes back to scan for incoming payments
VERIFY_WINDOW_MINUTES=15
